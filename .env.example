# Copia este archivo como ".env" y completa los valores reales ahí.
# El archivo ".env" nunca se sube al repositorio (ya está excluido en .gitignore).

# Gemini (Google AI Studio). La API key se saca de https://aistudio.google.com
GEMINI_API_KEY=tu_llave_aqui
GEMINI_MODEL=gemini-3.5-flash-lite

# DeepSeek (solo para los scripts viejos que usan HTTP directo)
DEEPSEEK_API_KEY=tu_llave_aqui
